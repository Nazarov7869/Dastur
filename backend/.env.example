# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# ".env" fayli maxfiy — uni hech kimga yubormang va git'ga qo'shmang.

# Serverga chiqarishda albatta o'zgartiring:
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram bot (@BotFather bergan token) va buyurtmalar tushadigan guruh/chat ID si.
# Bo'sh qoldirilsa, buyurtma saqlanadi, lekin Telegram'ga xabar yuborilmaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yetkazib berish narxlari (so'm)
FREE_DELIVERY_FROM=80000
DELIVERY_FEE=9000
SERVICE_FEE=2000
